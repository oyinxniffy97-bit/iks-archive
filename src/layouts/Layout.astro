---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "IK'S ARCHIVE | Publishing, Digital Skills & Media Enterprise Warri",
  description = "IK'S ARCHIVE is a hybrid multimedia content, publishing, and educational enterprise in Warri. Offering book publishing, AI masterclasses, CapCut editing, and tech hub resources.",
  image = "/vessels-of-mercy.jpg"
} = Astro.props;

// Active Navigation Link Helper
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://ik-archive.netlify.app");
const socialImageURL = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph Metadata (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="IK'S ARCHIVE" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "IK'S ARCHIVE",
        "description": "Hybrid multimedia content, publishing, and educational enterprise.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Warri",
          "addressRegion": "Delta State",
          "addressCountry": "NG"
        },
        "telephone": "+2348138662400",
        "knowsAbout": ["Digital Publishing", "AI Prompting", "CapCut Video Editing", "Graphic Design", "Academic Tutoring"]
      }
    </script>
  </head>

  <body class="bg-[#07121C] text-[#F3EFD8] font-['Plus_Jakarta_Sans',sans-serif] selection:bg-[#C9923A] selection:text-[#07121C] overflow-x-hidden antialiased min-h-screen flex flex-col justify-between">
    
    <!-- GLOBAL STICKY HEADER WITH MOBILE HAMBURGER MENU -->
    <header class="sticky top-0 z-50 bg-[#07121C]/95 backdrop-blur-md border-b border-[#C9923A]/30 px-4 sm:px-6 py-4">
      <nav class="max-w-7xl mx-auto flex justify-between items-center" aria-label="Main Navigation">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group" aria-label="IK'S ARCHIVE Homepage">
          <div class="w-10 h-10 rounded-full bg-[#07121C] border border-[#C9923A] overflow-hidden flex items-center justify-center shadow-[0_0_15px_rgba(201,146,58,0.25)] group-hover:scale-105 transition-all duration-300">
            <img src="/logo-transparent-500w.png" alt="IK'S ARCHIVE Logo" class="w-full h-full object-cover" />
          </div>
          <div class="flex flex-col">
            <span class="font-serif text-base sm:text-lg tracking-wider text-[#F3EFD8] font-bold leading-none">IK'S ARCHIVE</span>
            <span class="text-[8px] sm:text-[9px] text-[#C9923A] tracking-[0.25em] uppercase mt-1 font-semibold">Publishing & Media</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <div class="hidden lg:flex items-center gap-8 text-xs font-semibold tracking-[0.15em] text-[#F3EFD8]/80 uppercase">
          <a href="/" class={currentPath === '/' ? "text-[#1A7AB0] font-bold" : "hover:text-[#1A7AB0] transition-colors"}>Home</a>
          <a href="/publishing" class={currentPath === '/publishing' || currentPath === '/publishing/' ? "text-[#1A7AB0] font-bold" : "hover:text-[#1A7AB0] transition-colors"}>Publishing</a>
          <a href="/academy" class={currentPath === '/academy' || currentPath === '/academy/' ? "text-[#1A7AB0] font-bold" : "hover:text-[#1A7AB0] transition-colors"}>Academy</a>
          <a href="/media" class={currentPath === '/media' || currentPath === '/media/' ? "text-[#1A7AB0] font-bold" : "hover:text-[#1A7AB0] transition-colors"}>Multimedia</a>
          <a href="/hub" class={currentPath === '/hub' || currentPath === '/hub/' ? "text-[#1A7AB0] font-bold" : "hover:text-[#1A7AB0] transition-colors"}>Warri Hub</a>
          <a href="/contact" class={currentPath === '/contact' || currentPath === '/contact/' ? "text-[#1A7AB0] font-bold" : "hover:text-[#1A7AB0] transition-colors"}>Contact</a>
        </div>

        <!-- Right Controls: CTA & Hamburger Button -->
        <div class="flex items-center gap-3">
          <a href="/contact" class="hidden sm:inline-flex px-5 py-2 rounded-lg bg-[#1A7AB0] hover:bg-[#0C5278] text-[#F3EFD8] text-xs font-bold tracking-widest uppercase transition-all shadow-md border border-[#1A7AB0]">
            Get Started
          </a>

          <!-- Mobile Hamburger Toggle Button -->
          <button 
            id="mobile-menu-btn"
            type="button"
            class="lg:hidden p-2 rounded-lg bg-[#0C5278]/40 border border-[#1A7AB0]/40 text-[#F3EFD8] hover:text-[#C9923A] hover:border-[#C9923A] transition-all focus:outline-none"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
          >
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

      </nav>

      <!-- Mobile Dropdown Drawer -->
      <div 
        id="mobile-menu" 
        class="hidden lg:hidden mt-4 pt-4 border-t border-[#0C5278]/60 pb-4 space-y-2 transition-all duration-300"
      >
        <a href="/" class="block px-4 py-2 rounded-xl text-xs font-bold text-[#F3EFD8] hover:bg-[#1A7AB0]/20 hover:text-[#1A7AB0] tracking-wider uppercase transition-all">
          Home
        </a>
        <a href="/publishing" class="block px-4 py-2 rounded-xl text-xs font-bold text-[#F3EFD8] hover:bg-[#1A7AB0]/20 hover:text-[#1A7AB0] tracking-wider uppercase transition-all">
          Publishing Catalog
        </a>
        <a href="/academy" class="block px-4 py-2 rounded-xl text-xs font-bold text-[#F3EFD8] hover:bg-[#1A7AB0]/20 hover:text-[#1A7AB0] tracking-wider uppercase transition-all">
          Digital Academy
        </a>
        <a href="/media" class="block px-4 py-2 rounded-xl text-xs font-bold text-[#F3EFD8] hover:bg-[#1A7AB0]/20 hover:text-[#1A7AB0] tracking-wider uppercase transition-all">
          Multimedia Services
        </a>
        <a href="/hub" class="block px-4 py-2 rounded-xl text-xs font-bold text-[#F3EFD8] hover:bg-[#1A7AB0]/20 hover:text-[#1A7AB0] tracking-wider uppercase transition-all">
          Warri Innovation Hub
        </a>
        <a href="/contact" class="block px-4 py-2 rounded-xl text-xs font-bold text-[#F3EFD8] hover:bg-[#1A7AB0]/20 hover:text-[#1A7AB0] tracking-wider uppercase transition-all">
          Contact Us
        </a>

        <div class="pt-2 px-2 sm:hidden">
          <a href="/contact" class="block w-full text-center py-2.5 rounded-xl bg-[#1A7AB0] hover:bg-[#0C5278] text-[#F3EFD8] text-xs font-bold tracking-widest uppercase shadow-md">
            Get Started
          </a>
        </div>
      </div>
    </header>

    <!-- MAIN PAGE CONTENT -->
    <div class="flex-grow">
      <slot />
    </div>

    <!-- FLOATING WHATSAPP BUTTON (BOTTOM-LEFT) -->
    <a 
      href="https://wa.me/2348138662400?text=Hello%20IK'S%20ARCHIVE,%20I%20have%20an%20inquiry%20regarding..." 
      target="_blank" 
      rel="noopener noreferrer"
      class="fixed bottom-6 left-6 z-50 w-14 h-14 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white shadow-[0_0_25px_rgba(16,185,129,0.5)] border-2 border-emerald-400 transition-all hover:scale-110 flex items-center justify-center group focus:outline-none"
      aria-label="Chat on WhatsApp"
    >
      <svg class="w-7 h-7 fill-current group-hover:rotate-12 transition-transform" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </a>

    <!-- GLOBAL FOOTER -->
    <footer class="bg-[#07121C] border-t border-[#0C5278]/50 pt-16 pb-8 px-6 text-[#F3EFD8]">
