---
// src/pages/media.astro
import Layout from '../layouts/Layout.astro';
import AIChatbot from '../components/AI Chatbot.astro';

const mediaServices = [
  {
    title: "Short-Form Video Editing (Reels, TikTok, Shorts)",
    tag: "Video Production",
    desc: "High-retention editing featuring custom captions, visual hooks, sound effects, motion graphics, and speed ramps optimized for social media growth."
  },
  {
    title: "Brand Identity & Graphic Design",
    tag: "Visual Design",
    desc: "Comprehensive brand kit setup including logo development, color palette creation, Canva template systems, flyers, and digital media kits."
  },
  {
    title: "YouTube Video Production & Trailers",
    tag: "YouTube Media",
    desc: "End-to-end media editing for daily devotionals, book trailers, video podcasts, and long-form YouTube channel content."
  },
  {
    title: "Copywriting & Content Strategy",
    tag: "Content Strategy",
    desc: "Persuasive sales copywriting for ebook launch campaigns, landing pages, corporate profiles, and social media scripts."
  }
];

const videoGallery = [
  { title: "Open Heavens Daily Devotional", youtubeId: "EbndNgmz7Cs", category: "Daily Devotional" },
  { title: "Open Heavens Daily Devotional", youtubeId: "_tUSrTTxsXc", category: "Daily Devotional" },
  { title: "Open Heavens Daily Devotional", youtubeId: "zr4UqLjwUfc", category: "Daily Devotional" },
  { title: "Open Heavens Daily Devotional", youtubeId: "j98LbKr_ZsE", category: "Daily Devotional" },
  { title: "Chief Tortoise: Who chop my yam?!", youtubeId: "Ggp9zOzjrS8", category: "Animation" }
];
---

<Layout 
  title="Multimedia & Visual Solutions | IK'S ARCHIVE Warri"
  description="Professional video editing, graphic design, YouTube trailers, and branding solutions provided by IK'S ARCHIVE Multimedia Press in Warri, Nigeria."
>
  <main style="background-color: #07121C !important;" class="min-h-screen text-[#F3EFD8]">
    
    <!-- Hero Banner -->
    <section class="py-20 px-6 border-b border-[#0C5278]/40 text-center" style="background-color: #07121C !important;">
      <div class="max-w-4xl mx-auto space-y-4">
        <span class="text-[#C9923A] text-xs font-bold tracking-[0.25em] uppercase block">VISUAL & MEDIA PRODUCTION</span>
        <h1 class="font-serif text-4xl md:text-6xl font-bold text-[#F3EFD8]">Multimedia Services</h1>
        <p class="text-xs md:text-sm text-[#F3EFD8]/80 leading-relaxed font-light max-w-2xl mx-auto">
          High-impact video editing, visual design, and brand storytelling designed to build authority and drive digital engagement.
        </p>
      </div>
    </section>

    <!-- Services Grid (Updated to Dark Ink Navy Theme) -->
    <section class="py-20 px-6" style="background-color: #07121C !important;">
      <div class="max-w-7xl mx-auto space-y-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {mediaServices.map((service) => (
            <div class="p-8 rounded-2xl border border-[#1A7AB0]/30 shadow-xl flex flex-col justify-between hover:-translate-y-1 transition-transform duration-300" style="background-color: #0A1D2D !important;">
              <div>
                <span class="text-[9px] font-bold text-[#C9923A] uppercase tracking-wider block mb-2">{service.tag}</span>
                <h2 class="font-serif text-2xl font-bold text-[#F3EFD8] mb-3">{service.title}</h2>
                <p class="text-xs text-[#F3EFD8]/75 leading-relaxed font-light mb-6">{service.desc}</p>
              </div>
              <a href="/contact" class="text-xs font-bold text-[#1A7AB0] hover:text-[#C9923A] uppercase tracking-wider transition-colors">
                Book Media Project →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Video Showcase (Mobile-Optimized Embeds) -->
    <section class="py-20 px-6 border-t border-[#0C5278]/40" style="background-color: #07121C !important;">
      <div class="max-w-7xl mx-auto space-y-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between">
          <div>
            <span class="text-[#C9923A] text-xs font-bold tracking-[0.25em] uppercase block mb-2">PRODUCED REELS</span>
            <h2 class="font-serif text-3xl md:text-5xl font-bold text-[#F3EFD8]">Featured Video Showcase</h2>
          </div>
          <a href="https://www.youtube.com/@ojosundayikponmownsa4782" target="_blank" rel="noopener noreferrer" class="mt-4 md:mt-0 text-xs font-bold text-[#1A7AB0] hover:text-[#C9923A] uppercase tracking-wider transition-colors">
            Subscribe on YouTube →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
          {videoGallery.map((video) => (
            <div class="rounded-2xl overflow-hidden shadow-2xl border border-[#C9923A]/30 flex flex-col justify-between" style="background-color: #0A1D2D !important;">
              <div class="relative w-full aspect-[9/16] bg-[#07121C]">
                <iframe 
                  class="w-full h-full rounded-t-2xl"
                  src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
                  title={video.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen
                ></iframe>
              </div>
              <div class="p-4 border-t border-[#0C5278]/50" style="background-color: #0A1D2D !important;">
                <span class="text-[9px] font-bold text-[#C9923A] uppercase block mb-1">{video.category}</span>
                <h3 class="font-serif text-xs font-bold text-[#F3EFD8] line-clamp-1">{video.title}</h3>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <AIChatbot />
</Layout>