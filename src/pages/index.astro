---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import AIChatbot from '../components/AI Chatbot.astro';

// Exact Verified YouTube Shorts Video Data
const featuredVideos = [
  {
    title: "Open Heavens Daily Devotional",
    category: "Daily Devotional",
    youtubeId: "EbndNgmz7Cs", 
    description: "Daily spiritual reflection and guidance from Open Heavens."
  },
  {
    title: "Open Heavens Daily Devotional",
    category: "Daily Devotional",
    youtubeId: "_tUSrTTxsXc", 
    description: "Daily spiritual message on God's love and grace."
  },
  {
    title: "Open Heavens Daily Devotional",
    category: "Daily Devotional",
    youtubeId: "zr4UqLjwUfc", 
    description: "Empowered Men 2026 — Faith, purpose, and spiritual growth."
  },
  {
    title: "Open Heavens Daily Devotional",
    category: "Daily Devotional",
    youtubeId: "j98LbKr_ZsE", 
    description: "God Do Not... — Inspiring daily word and teachings."
  },
  {
    title: "Chief Tortoise: Who chop my yam?!",
    category: "Animation & Storytelling",
    youtubeId: "Ggp9zOzjrS8", 
    description: "A funny and engaging traditional folklore animated story."
  }
];

// Verified Selar eBooks & Literary Catalog
const featuredBooks = [
  {
    title: "BLOODLIES",
    subtitle: "A Novella of Family, Mischief, and the Meaning of Blood",
    author: "Ojo Sunday Ikponmwonsa Oritsemiegbegbemi",
    category: "PDF eBook",
    description: "Every family has secrets. Caught between a stern father and protective mother, Tomiwa's life unravels when a stranger claims to be his true biological father.",
    selarUrl: "https://selar.com/j4z0n99rk4",
    badge: "Bestseller",
    coverImage: "/bloodlies.jpg",
    borderCol: "border-[#C9923A]/40",
    hoverGlow: "hover:shadow-[0_10px_35px_rgba(201,146,58,0.25)] hover:border-[#C9923A]"
  },
  {
    title: "STILL WAITING:",
    subtitle: "A Warri Love Story",
    author: "Ojo Sunday Ikponmwonsa Oritsemiegbegbemi & Tammy Abdullahi",
    category: "Novella",
    description: "Based on a true account. A gripping romance set in Warri exploring patience, long-standing promises, and the quiet sacrifices of enduring love.",
    selarUrl: "https://selar.com",
    badge: "True Account",
    coverImage: "/still-waiting.jpg",
    borderCol: "border-[#C9923A]/60",
    hoverGlow: "hover:shadow-[0_10px_35px_rgba(201,146,58,0.3)] hover:border-[#C9923A]"
  },
  {
    title: "FATHER'S SHADOW",
    subtitle: "A Novella of Inheritance, Rage, and Redemption",
    author: "Ojo Sunday Ikponmwonsa Oritsemiegbegbemi",
    category: "Novella",
    description: "When three generations of the Erhabor family converge at the police station in Effurun, decades of buried domestic trauma and rage break wide open.",
    selarUrl: "https://selar.com/3g88328sy7",
    badge: "Featured",
    coverImage: "/father's_shadow.jpg",
    borderCol: "border-[#1A7AB0]/40",
    hoverGlow: "hover:shadow-[0_10px_35px_rgba(26,122,176,0.3)] hover:border-[#1A7AB0]"
  },
  {
    title: "VESSELS OF MERCY",
    subtitle: "A Novella of Grace, Regret, and Restoration",
    author: "Ojo Sunday Ikponmwonsa Oritsemiegbegbemi",
    category: "2026 Release",
    description: "Set in Warri, following Tamar and Caro—two women who make the same mistake at sixteen and take two entirely different roads toward grace and restoration.",
    selarUrl: "https://selar.com/p65387k4vc",
    badge: "Selar Press",
    coverImage: "/vessels-of-mercy.jpg",
    borderCol: "border-[#C9923A]/50",
    hoverGlow: "hover:shadow-[0_10px_35px_rgba(201,146,58,0.3)] hover:border-[#C9923A]"
  }
];
---

<Layout 
  title="IK'S ARCHIVE | Publishing, Digital Education & Media Enterprise"
  description="IK'S ARCHIVE blends creative media production, digital education masterclasses (AI, Canva, CapCut), original book publishing, and the Warri Innovation Hub."
>

  <main style="background-color: #07121C !important;" class="min-h-screen">
    
    <!-- SECTION 1: DARK INK NAVY HERO -->
    <section class="relative py-20 md:py-28 px-6 overflow-hidden reveal-section" style="background-color: #07121C !important;" aria-label="Hero Overview">
      
      <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-[#1A7AB0]/20 rounded-full blur-[140px] pointer-events-none animate-pulse"></div>

      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
        
        <!-- Hero Text Column -->
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0C5278]/40 border border-[#1A7AB0]/60 shadow-[0_0_15px_rgba(26,122,176,0.25)]">
            <span class="w-2 h-2 rounded-full bg-[#1A7AB0] animate-ping"></span>
            <span class="text-[#F3EFD8] text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase">
              HYBRID MULTIMEDIA & PUBLISHING ENTERPRISE
            </span>
          </div>

          <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-[#F3EFD8] leading-[1.1] tracking-tight">
            Premium Content. <br />
            <span class="text-[#1A7AB0]">Intelligent</span> <span class="text-[#C9923A] font-serif italic font-normal">Publishing.</span>
          </h1>

          <p class="text-[#F3EFD8]/85 text-sm md:text-base leading-relaxed max-w-md font-light">
            IK'S ARCHIVE is a multi-disciplinary hub bridging creative media production, digital education masterclasses, and original book publishing.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a href="/publishing" class="px-7 py-3.5 rounded-xl bg-[#1A7AB0] hover:bg-[#0C5278] text-[#F3EFD8] text-xs font-bold tracking-wider uppercase transition-all shadow-[0_0_25px_rgba(26,122,176,0.4)] border border-[#1A7AB0] hover:-translate-y-1">
              Explore Publications →
            </a>
            <a href="/academy" class="px-7 py-3.5 rounded-xl bg-[#07121C]/80 border border-[#C9923A]/50 text-[#F3EFD8] hover:border-[#1A7AB0] hover:text-[#1A7AB0] text-xs font-bold tracking-wider uppercase transition-all backdrop-blur-sm shadow-md hover:-translate-y-1">
              Join Masterclasses
            </a>
          </div>
        </div>

        <!-- 3D Showcase Stack -->
        <div class="flex justify-center relative" role="img" aria-label="3D Stack of Original Book Covers">
          <div class="relative w-full max-w-md aspect-square flex items-center justify-center p-2">
            <div class="absolute w-72 h-72 bg-[#1A7AB0]/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative w-full h-full flex items-center justify-center">
              
              <!-- Book 1 Left: BLOODLIES -->
              <a href="https://selar.com/j4z0n99rk4" target="_blank" rel="noopener noreferrer" class="absolute -left-2 sm:left-4 top-10 w-36 sm:w-40 aspect-[2/3] rounded-lg overflow-hidden shadow-2xl border border-[#C9923A]/40 transform -rotate-12 hover:rotate-0 hover:scale-105 transition-all duration-500 cursor-pointer group">
                <img src="/bloodlies.jpg" alt="BLOODLIES Book Cover" class="w-full h-full object-cover" />
              </a>

              <!-- Book 2 Right: FATHER'S SHADOW -->
              <a href="https://selar.com/3g88328sy7" target="_blank" rel="noopener noreferrer" class="absolute -right-2 sm:right-4 top-12 w-36 sm:w-40 aspect-[2/3] rounded-lg overflow-hidden shadow-2xl border border-[#C9923A]/50 transform rotate-12 hover:rotate-0 hover:scale-105 transition-all duration-500 cursor-pointer group">
                <img src="/father's_shadow.jpg" alt="Father's Shadow Book Cover" class="w-full h-full object-cover" />
              </a>

              <!-- Main Center Cover: VESSELS OF MERCY -->
              <a href="https://selar.com/p65387k4vc" target="_blank" rel="noopener noreferrer" class="relative z-20 w-44 sm:w-48 aspect-[2/3] rounded-xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.9)] border-2 border-[#1A7AB0] transform hover:scale-110 transition-all duration-500 cursor-pointer group">
                <img src="/vessels-of-mercy.jpg" alt="Vessels of Mercy Book Cover" class="w-full h-full object-cover" />
              </a>

            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 2: CORE OPERATIONS SERVICES -->
    <section class="py-20 px-6 text-[#F3EFD8] border-t border-[#0C5278]/40 reveal-section" style="background-color: #07121C !important;" aria-labelledby="operations-heading">
      <div class="max-w-7xl mx-auto">
        
        <div class="text-center max-w-2xl mx-auto mb-14">
          <span class="text-[#C9923A] text-xs font-bold tracking-[0.25em] uppercase block mb-2">
            CORE OPERATIONS
          </span>
          <h2 id="operations-heading" class="font-serif text-3xl md:text-5xl font-bold text-[#F3EFD8]">
            Services & Operations
          </h2>
          <p class="text-xs md:text-sm text-[#F3EFD8]/75 mt-3 leading-relaxed font-light">
            Bridging creative media production, digital education, book publishing, and innovation infrastructure.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          
          <article class="p-8 rounded-2xl border border-[#1A7AB0]/30 shadow-xl hover:border-[#1A7AB0] hover:shadow-[0_10px_30px_rgba(26,122,176,0.25)] hover:-translate-y-2 transition-all duration-300 group" style="background-color: #0A1D2D !important;">
            <div class="w-12 h-12 rounded-xl bg-[#1A7AB0]/20 border border-[#1A7AB0]/50 flex items-center justify-center text-[#1A7AB0] font-serif font-bold text-lg mb-5 group-hover:bg-[#1A7AB0] group-hover:text-white transition-all">
              01
            </div>
            <h3 class="font-serif font-bold text-lg text-[#F3EFD8] mb-2 group-hover:text-[#1A7AB0] transition-colors">
              Digital Publishing & Storytelling
            </h3>
            <p class="text-xs text-[#F3EFD8]/80 leading-relaxed mb-6 font-light">
              Publishing original novellas, ebooks, and novels (<em>Still Waiting</em>, <em>BLOODLIES</em>, <em>Father's Shadow</em>, <em>Vessels of Mercy</em>) via Selar, plus copywriting.
            </p>
            <span class="text-[10px] font-bold text-[#1A7AB0] uppercase tracking-wider block border-t border-[#0C5278]/50 pt-3">• Ebooks & Novels • Selar Distribution</span>
          </article>

          <article class="p-8 rounded-2xl border border-[#C9923A]/30 shadow-xl hover:border-[#C9923A] hover:shadow-[0_10px_30px_rgba(201,146,58,0.25)] hover:-translate-y-2 transition-all duration-300 group" style="background-color: #0A1D2D !important;">
            <div class="w-12 h-12 rounded-xl bg-[#C9923A]/20 border border-[#C9923A]/50 flex items-center justify-center text-[#C9923A] font-serif font-bold text-lg mb-5 group-hover:bg-[#C9923A] group-hover:text-white transition-all">
              02
            </div>
            <h3 class="font-serif font-bold text-lg text-[#F3EFD8] mb-2 group-hover:text-[#C9923A] transition-colors">
              Multimedia & Visual Content
            </h3>
            <p class="text-xs text-[#F3EFD8]/80 leading-relaxed mb-6 font-light">
              Professional media solutions including short-form video editing, graphic design, YouTube trailers, logo analysis, and brand campaigns.
            </p>
            <span class="text-[10px] font-bold text-[#C9923A] uppercase tracking-wider block border-t border-[#0C5278]/50 pt-3">• Video Editing • Graphic Design • Branding</span>
          </article>

          <article class="p-8 rounded-2xl border border-[#1A7AB0]/30 shadow-xl hover:border-[#1A7AB0] hover:shadow-[0_10px_30px_rgba(26,122,176,0.25)] hover:-translate-y-2 transition-all duration-300 group" style="background-color: #0A1D2D !important;">
            <div class="w-12 h-12 rounded-xl bg-[#1A7AB0]/20 border border-[#1A7AB0]/50 flex items-center justify-center text-[#1A7AB0] font-serif font-bold text-lg mb-5 group-hover:bg-[#1A7AB0] group-hover:text-white transition-all">
              03
            </div>
            <h3 class="font-serif font-bold text-lg text-[#F3EFD8] mb-2 group-hover:text-[#1A7AB0] transition-colors">
              AI & Digital Skills Education
            </h3>
            <p class="text-xs text-[#F3EFD8]/80 leading-relaxed mb-6 font-light">
              Hosting hands-on workshops covering AI prompt engineering, Canva graphic design, CapCut video editing, and content automation workflows.
            </p>
            <span class="text-[10px] font-bold text-[#1A7AB0] uppercase tracking-wider block border-t border-[#0C5278]/50 pt-3">• AI Prompting • Canva • CapCut Workshops</span>
          </article>

          <article class="p-8 rounded-2xl border border-[#C9923A]/30 shadow-xl hover:border-[#C9923A] hover:shadow-[0_10px_30px_rgba(201,146,58,0.25)] hover:-translate-y-2 transition-all duration-300 group" style="background-color: #0A1D2D !important;">
            <div class="w-12 h-12 rounded-xl bg-[#C9923A]/20 border border-[#C9923A]/50 flex items-center justify-center text-[#C9923A] font-serif font-bold text-lg mb-5 group-hover:bg-[#C9923A] group-hover:text-white transition-all">
              04
            </div>
            <h3 class="font-serif font-bold text-lg text-[#F3EFD8] mb-2 group-hover:text-[#C9923A] transition-colors">
              Academic & Youth Empowerment
            </h3>
            <p class="text-xs text-[#F3EFD8]/80 leading-relaxed mb-6 font-light">
              Academic tutoring, study guides, and youth mentorship designed to build practical, real-world digital capabilities.
            </p>
            <span class="text-[10px] font-bold text-[#C9923A] uppercase tracking-wider block border-t border-[#0C5278]/50 pt-3">• Tutoring • Study Guides • Mentorship</span>
          </article>

          <article class="p-8 rounded-2xl border border-[#1A7AB0]/30 shadow-xl hover:border-[#1A7AB0] hover:shadow-[0_10px_30px_rgba(26,122,176,0.25)] hover:-translate-y-2 transition-all duration-300 group lg:col-span-2" style="background-color: #0A1D2D !important;">
            <div class="w-12 h-12 rounded-xl bg-[#1A7AB0]/20 border border-[#1A7AB0]/50 flex items-center justify-center text-[#1A7AB0] font-serif font-bold text-lg mb-5 group-hover:bg-[#1A7AB0] group-hover:text-white transition-all">
              05
            </div>
            <h3 class="font-serif font-bold text-lg text-[#F3EFD8] mb-2 group-hover:text-[#1A7AB0] transition-colors">
              Resource & Business Hub (Warri Center)
            </h3>
            <p class="text-xs text-[#F3EFD8]/80 leading-relaxed mb-6 font-light">
              Expanding physical & digital infrastructure in Warri delivering document processing, high-speed printing, tech infrastructure access, and collaborative workspaces.
            </p>
            <span class="text-[10px] font-bold text-[#1A7AB0] uppercase tracking-wider block border-t border-[#0C5278]/50 pt-3">• Document Processing • Printing • Workspaces</span>
          </article>

        </div>
      </div>
    </section>

    <!-- SECTION 3: FEATURED EBOOK PUBLICATIONS -->
    <section class="py-20 px-6 text-[#F3EFD8] border-t border-[#0C5278]/40 reveal-section" style="background-color: #07121C !important;">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <span class="text-[#C9923A] text-xs font-bold tracking-[0.25em] uppercase block mb-2">FEATURED PUBLICATIONS</span>
          <h2 class="font-serif text-3xl md:text-5xl font-bold text-[#F3EFD8]">Original Literary Catalog</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredBooks.map((book) => (
            <div class={`border ${book.borderCol} rounded-2xl p-5 ${book.hoverGlow} transition-all hover:-translate-y-2 duration-300 group flex flex-col justify-between shadow-xl`} style="background-color: #0A1D2D !important;">
              <div>
                <div class="w-full aspect-[2/3] rounded-xl overflow-hidden mb-4 border border-[#C9923A]/30 shadow-lg">
                  <img src={book.coverImage} alt={`${book.title} Cover`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>

                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] text-[#C9923A] font-bold tracking-widest uppercase">{book.category}</span>
                  <span class="text-[9px] px-2 py-0.5 rounded-full bg-[#1A7AB0]/20 text-[#1A7AB0] border border-[#1A7AB0]/30 font-bold uppercase">{book.badge}</span>
                </div>
                <h3 class="font-serif text-lg font-bold text-[#F3EFD8] mb-1 group-hover:text-[#1A7AB0] transition-colors">{book.title}</h3>
                <p class="text-[10px] text-[#C9923A] italic mb-1">{book.subtitle}</p>
                <p class="text-[9px] text-[#F3EFD8]/60 font-mono mb-3">By {book.author}</p>
                <p class="text-xs text-[#F3EFD8]/75 leading-relaxed font-light">{book.description}</p>
              </div>
              <a 
                href={book.selarUrl} 
                target="_blank"
                rel="noopener noreferrer" 
                class="mt-6 text-xs text-[#1A7AB0] font-bold flex items-center gap-1 group-hover:translate-x-2 transition-transform"
              >
                Buy on Selar →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 4: YOUTUBE SHORTS VERTICAL VIDEO GALLERY -->
    <section class="py-20 px-6 text-[#F3EFD8] border-t border-[#0C5278]/40 reveal-section" style="background-color: #07121C !important;" aria-labelledby="video-section-heading">
      <div class="max-w-7xl mx-auto">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <span class="text-[#C9923A] text-xs font-bold tracking-[0.25em] uppercase block mb-2">
              MULTIMEDIA CHANNEL
            </span>
            <h2 id="video-section-heading" class="font-serif text-3xl md:text-5xl font-bold text-[#F3EFD8]">
              Featured Shorts & Devotionals
            </h2>
          </div>
          <a 
            href="https://www.youtube.com/@ojosundayikponmownsa4782" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="mt-4 md:mt-0 inline-flex items-center gap-2 text-xs font-bold text-[#1A7AB0] hover:text-[#C9923A] transition-colors uppercase tracking-wider"
          >
            Subscribe to YouTube Channel →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
          {featuredVideos.map((video) => (
            <div class="rounded-2xl overflow-hidden shadow-2xl border border-[#C9923A]/30 flex flex-col justify-between hover:scale-[1.02] hover:border-[#C9923A] transition-all duration-300" style="background-color: #0A1D2D !important;">
              
              <div class="relative w-full aspect-[9/16] bg-black">
                <iframe 
                  class="w-full h-full object-cover"
                  src={`https://www.youtube.com/embed/${video.youtubeId}?rel=0&modestbranding=1`}
                  title={video.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                  allowfullscreen
                ></iframe>
              </div>

              <div class="p-4 text-[#F3EFD8] border-t border-[#0C5278]" style="background-color: #07121C !important;">
                <span class="text-[9px] font-bold text-[#C9923A] tracking-wider uppercase block mb-1">
                  {video.category}
                </span>
                <h3 class="font-serif text-xs font-bold text-[#F3EFD8] line-clamp-1 mb-1">
                  {video.title}
                </h3>
                <p class="text-[10px] text-[#F3EFD8]/75 leading-normal font-light line-clamp-2">
                  {video.description}
                </p>
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- SECTION 5: CONTACT & INQUIRY FORM -->
    <section id="contact-section" class="relative py-28 px-6 border-t border-[#0C5278]/50 overflow-hidden reveal-section" style="background-color: #07121C !important;" aria-labelledby="contact-heading">
      
      <div class="absolute top-1/2 right-10 w-[450px] h-[450px] bg-[#1A7AB0]/15 rounded-full blur-[130px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start relative z-10">
        
        <div class="lg:col-span-5 space-y-8">
          <div>
            <span class="text-[#C9923A] text-xs font-bold tracking-[0.25em] uppercase block mb-3">
              GET IN TOUCH
            </span>
            <h2 id="contact-heading" class="font-serif text-4xl md:text-5xl font-bold text-[#F3EFD8] leading-[1.15]">
              Let's Build Something <span class="text-[#1A7AB0]">Meaningful.</span>
            </h2>
            <p class="text-xs md:text-sm text-[#F3EFD8]/80 leading-relaxed font-light mt-4">
              Whether you're looking to acquire original publications, join our AI & media masterclasses, or book infrastructure at the Warri Innovation Hub, reach out directly.
            </p>
          </div>

          <div class="space-y-4">
            <div class="flex items-center gap-4 p-4 rounded-xl border border-[#1A7AB0]/30 shadow-md" style="background-color: #0A1D2D !important;">
              <div class="w-10 h-10 rounded-lg bg-[#1A7AB0]/20 border border-[#1A7AB0]/40 flex items-center justify-center text-[#1A7AB0] text-base shrink-0">📍</div>
              <div>
                <span class="text-[#C9923A] font-bold uppercase block text-[10px] tracking-wider">Physical Center</span>
                <span class="text-xs text-[#F3EFD8]">Warri, Delta State, Nigeria</span>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 rounded-xl border border-[#1A7AB0]/30 shadow-md" style="background-color: #0A1D2D !important;">
              <div class="w-10 h-10 rounded-lg bg-[#1A7AB0]/20 border border-[#1A7AB0]/40 flex items-center justify-center text-[#1A7AB0] text-base shrink-0">✉️</div>
              <div>
                <span class="text-[#C9923A] font-bold uppercase block text-[10px] tracking-wider">Direct Email</span>
                <a href="mailto:info@iksarchive.com" class="text-xs text-[#F3EFD8] hover:text-[#1A7AB0] transition-colors">info@iksarchive.com</a>
              </div>
            </div>

            <div class="flex items-center gap-4 p-4 rounded-xl border border-[#1A7AB0]/30 shadow-md" style="background-color: #0A1D2D !important;">
              <div class="w-10 h-10 rounded-lg bg-[#1A7AB0]/20 border border-[#1A7AB0]/40 flex items-center justify-center text-[#1A7AB0] text-base shrink-0">📞</div>
              <div>
                <span class="text-[#C9923A] font-bold uppercase block text-[10px] tracking-wider">Direct Call / WhatsApp</span>
                <a href="tel:+2348138662400" class="text-xs text-[#F3EFD8] hover:text-[#1A7AB0] transition-colors">+234 (0) 813 866 2400</a>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 border-2 border-[#1A7AB0]/40 rounded-2xl p-8 md:p-10 shadow-[0_20px_50px_rgba(0,0,0,0.6)]" style="background-color: #0A1D2D !important;">
          <form class="space-y-6" action="#" method="POST">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
