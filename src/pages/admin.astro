---
// src/pages/admin.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Admin Dashboard | IK'S ARCHIVE Enterprise"
  description="Internal admin monitoring dashboard for IK'S ARCHIVE website traffic, lead inquiries, and chat metrics."
>
  <main style="background-color: #07121C !important;" class="min-h-screen text-[#F3EFD8] pt-24 pb-16 px-6">
    
    <!-- AUTHENTICATION PIN MODAL (Security Screen) -->
    <div id="pin-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 backdrop-blur-xl" style="background-color: rgba(7, 18, 28, 0.95) !important;">
      <div class="w-full max-w-md border-2 border-[#1A7AB0]/50 rounded-2xl p-8 shadow-[0_20px_50px_rgba(0,0,0,0.9)] text-center" style="background-color: #0A1D2D !important;">
        <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#1A7AB0]/20 border border-[#C9923A] flex items-center justify-center text-[#C9923A] font-bold text-xl">
          🔐
        </div>
        <h2 class="font-serif text-2xl font-bold text-[#F3EFD8] mb-2">Admin Security Check</h2>
        <p class="text-xs text-[#F3EFD8]/70 mb-6 font-light">Enter your authorization PIN to view IK'S ARCHIVE real-time analytics and event stream.</p>
        
        <form id="pin-form" class="space-y-4">
          <input 
            type="password" 
            id="pin-input" 
            placeholder="Enter Admin PIN (Default: 1234)" 
            required 
            class="w-full px-4 py-3 rounded-xl border border-[#1A7AB0]/50 text-center text-sm text-[#F3EFD8] tracking-widest focus:outline-none focus:border-[#C9923A]"
            style="background-color: #07121C !important;"
          />
          <p id="pin-error" class="text-xs text-rose-400 hidden">Incorrect PIN passcode. Please try again.</p>
          <button 
            type="submit" 
            class="w-full py-3.5 rounded-xl bg-[#1A7AB0] hover:bg-[#0C5278] text-[#F3EFD8] text-xs font-bold uppercase tracking-wider transition-all border border-[#1A7AB0]"
          >
            Unlock Dashboard →
          </button>
        </form>
      </div>
    </div>

    <!-- MAIN DASHBOARD CONTENT (Hidden until unlocked) -->
    <div id="dashboard-content" class="max-w-7xl mx-auto space-y-8 hidden">
      
      <!-- Top Title Bar -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#0C5278]/50 pb-6 p-6 rounded-2xl border border-[#1A7AB0]/30 shadow-xl" style="background-color: #0A1D2D !important;">
        <div>
          <span class="text-[#C9923A] text-xs font-bold tracking-[0.25em] uppercase block mb-1">
            ENTERPRISE CONTROL PANEL
          </span>
          <h1 class="font-serif text-3xl md:text-4xl font-bold text-[#F3EFD8]">IK'S ARCHIVE Analytics & Operations</h1>
          <p class="text-xs text-[#F3EFD8]/70 mt-1 font-light">Real-time tracking for user sessions, outbound link clicks, bot interactions, and lead forms.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#1A7AB0]/20 border border-[#1A7AB0]/50 text-xs font-bold text-[#1A7AB0]">
            <span class="w-2 h-2 rounded-full bg-[#1A7AB0] animate-ping"></span>
            SYSTEM LIVE
          </span>
          <button 
            id="clear-analytics-btn"
            class="px-4 py-2 rounded-xl bg-[#8F3D1C]/30 border border-[#8F3D1C] text-[#F3EFD8] hover:bg-[#8F3D1C] text-xs font-bold transition-all shadow-md"
          >
            Clear Log Data
          </button>
          <button 
            id="lock-portal-btn"
            class="px-4 py-2 rounded-xl bg-rose-500/20 border border-rose-500/40 text-rose-300 hover:bg-rose-500/30 text-xs font-bold transition-all"
          >
            Lock Dashboard 🔒
          </button>
        </div>
      </div>

      <!-- Metric Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Metric 1: Page Views -->
        <div class="border border-[#1A7AB0]/30 rounded-2xl p-6 backdrop-blur-md shadow-xl" style="background-color: #0A1D2D !important;">
          <span class="text-[10px] text-[#C9923A] font-bold uppercase tracking-wider block mb-2">Total Page Views</span>
          <div id="stat-views" class="font-serif text-3xl font-bold text-[#F3EFD8]">0</div>
          <span class="text-[10px] text-[#F3EFD8]/60 mt-2 block">Tracked website sessions</span>
        </div>

        <!-- Metric 2: Link Clicks -->
        <div class="border border-[#1A7AB0]/30 rounded-2xl p-6 backdrop-blur-md shadow-xl" style="background-color: #0A1D2D !important;">
          <span class="text-[10px] text-[#C9923A] font-bold uppercase tracking-wider block mb-2">Button Clicks & Conversions</span>
          <div id="stat-clicks" class="font-serif text-3xl font-bold text-[#1A7AB0]">0</div>
          <span class="text-[10px] text-[#F3EFD8]/60 mt-2 block">Selar & External outbound links</span>
        </div>

        <!-- Metric 3: AI Chatbot -->
        <div class="border border-[#1A7AB0]/30 rounded-2xl p-6 backdrop-blur-md shadow-xl" style="background-color: #0A1D2D !important;">
          <span class="text-[10px] text-[#C9923A] font-bold uppercase tracking-wider block mb-2">AI Chatbot Queries</span>
          <div id="stat-chats" class="font-serif text-3xl font-bold text-[#F3EFD8]">0</div>
          <span class="text-[10px] text-[#F3EFD8]/60 mt-2 block">Automated user interactions</span>
        </div>

        <!-- Metric 4: Form Leads -->
        <div class="border border-[#1A7AB0]/30 rounded-2xl p-6 backdrop-blur-md shadow-xl" style="background-color: #0A1D2D !important;">
          <span class="text-[10px] text-[#C9923A] font-bold uppercase tracking-wider block mb-2">Form Leads</span>
          <div id="stat-leads" class="font-serif text-3xl font-bold text-[#C9923A]">0</div>
          <span class="text-[10px] text-[#F3EFD8]/60 mt-2 block">Contact section inquiries</span>
        </div>

      </div>

      <!-- Real-time Event Logs Table -->
      <div class="border border-[#1A7AB0]/30 rounded-2xl p-6 md:p-8 backdrop-blur-md space-y-4 shadow-2xl" style="background-color: #0A1D2D !important;">
        <div class="flex justify-between items-center">
          <div>
            <h3 class="font-serif font-bold text-lg text-[#F3EFD8]">Real-time Event Stream</h3>
            <p class="text-xs text-[#F3EFD8]/60 font-light mt-0.5">Live user action logs from `localStorage`</p>
          </div>
          <span class="text-xs text-[#C9923A] font-mono">Auto-refreshing</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr class="border-b border-[#0C5278] text-[#C9923A] uppercase tracking-wider text-[10px]">
                <th class="py-3 px-4">Event Type</th>
                <th class="py-3 px-4">Details / Label</th>
                <th class="py-3 px-4">Timestamp</th>
              </tr>
            </thead>
            <tbody id="events-table-body" class="divide-y divide-[#0C5278]/40 font-light">
              <tr>
                <td colspan="3" class="py-6 text-center text-[#F3EFD8]/50">No activity recorded yet. Browse the site to generate logs.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- External Quick Links -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-[#1A7AB0]/30 space-y-2" style="background-color: #0A1D2D !important;">
          <h4 class="font-serif font-bold text-sm text-[#F3EFD8]">📚 Selar Press Merchant</h4>
          <p class="text-xs text-[#F3EFD8]/70 font-light">Manage sales for BLOODLIES and Vessels of Mercy.</p>
          <a href="https://selar.com" target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-bold text-[#1A7AB0] hover:text-[#C9923A] transition-colors">
            Open Selar Merchant Console →
          </a>
        </div>

        <div class="p-6 rounded-2xl border border-[#C9923A]/30 space-y-2" style="background-color: #0A1D2D !important;">
          <h4 class="font-serif font-bold text-sm text-[#F3EFD8]">🎬 YouTube Creator Studio</h4>
          <p class="text-xs text-[#F3EFD8]/70 font-light">Manage Open Heavens Shorts and Devotionals.</p>
          <a href="https://studio.youtube.com" target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-bold text-[#C9923A] hover:text-[#1A7AB0] transition-colors">
            Open YouTube Studio →
          </a>
        </div>

        <div class="p-6 rounded-2xl border border-[#1A7AB0]/30 space-y-2" style="background-color: #0A1D2D !important;">
          <h4 class="font-serif font-bold text-sm text-[#F3EFD8]">⚡ Netlify Management</h4>
          <p class="text-xs text-[#F3EFD8]/70 font-light">Deploy updates and configure custom domain DNS.</p>
          <a href="https://app.netlify.com" target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-bold text-[#1A7AB0] hover:text-[#C9923A] transition-colors">
            Open Netlify Console →
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  import { getStoredEvents } from '../lib/analytics';

  document.addEventListener('DOMContentLoaded', () => {
    const pinModal = document.getElementById('pin-modal');
    const pinForm = document.getElementById('pin-form');
    const pinInput = document.getElementById('pin-input') as HTMLInputElement;
    const pinError = document.getElementById('pin-error');
    const dashboardContent = document.getElementById('dashboard-content');
    const lockPortalBtn = document.getElementById('lock-portal-btn');
    const clearAnalyticsBtn = document.getElementById('clear-analytics-btn');

    const CORRECT_PIN = "1234";

    // 1. PIN Security Authentication Check
    if (sessionStorage.getItem('admin_authenticated') === 'true') {
      pinModal?.classList.add('hidden');
      dashboardContent?.classList.remove('hidden');
      renderDashboard();
    }

    pinForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const enteredPin = pinInput?.value.trim();

      if (enteredPin === CORRECT_PIN) {
        sessionStorage.setItem('admin_authenticated', 'true');
        pinModal?.classList.add('hidden');
        dashboardContent?.classList.remove('hidden');
        pinError?.classList.add('hidden');
        renderDashboard();
      } else {
        pinError?.classList.remove('hidden');
      }
    });

    lockPortalBtn?.addEventListener('click', () => {
      sessionStorage.removeItem('admin_authenticated');
      dashboardContent?.classList.add('hidden');
      pinModal?.classList.remove('hidden');
      if (pinInput) pinInput.value = '';
    });

    // 2. Render Analytics Data & Table
    function renderDashboard() {
      const events = getStoredEvents();
      
      // Calculate Metrics
      const views = events.filter(e => e.type === 'pageview').length;
      const clicks = events.filter(e => e.type === 'click').length;
      const chats = events.filter(e => e.type === 'chat_query').length;
      const leads = events.filter(e => e.type === 'form_submit').length;

      const viewsEl = document.getElementById('stat-views');
      const clicksEl = document.getElementById('stat-clicks');
      const chatsEl = document.getElementById('stat-chats');
      const leadsEl = document.getElementById('stat-leads');
      const tbody = document.getElementById('events-table-body');

      if (viewsEl) viewsEl.textContent = views.toString();
      if (clicksEl) clicksEl.textContent = clicks.toString();
      if (chatsEl) chatsEl.textContent = chats.toString();
      if (leadsEl) leadsEl.textContent = leads.toString();

      if (tbody) {
        if (events.length === 0) {
          tbody.innerHTML = `<tr><td colspan="3" class="py-6 text-center text-[#F3EFD8]/50">No activity recorded yet. Browse the site to generate logs.</td></tr>`;
          return;
        }

        tbody.innerHTML = events.slice(0, 20).map(event => {
          let badgeColor = 'bg-[#1A7AB0]/20 text-[#1A7AB0] border-[#1A7AB0]/40';
          if (event.type === 'click') badgeColor = 'bg-[#C9923A]/20 text-[#C9923A] border-[#C9923A]/40';
          if (event.type === 'chat_query') badgeColor = 'bg-purple-500/20 text-purple-300 border-purple-500/40';
          if (event.type === 'form_submit') badgeColor = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40';

          const formattedTime = new Date(event.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

          return `
            <tr class="hover:bg-[#07121C]/50 transition-colors">
              <td class="py-3 px-4">
                <span class="px-2 py-1 rounded-md text-[9px] font-bold border uppercase tracking-wider ${badgeColor}">
                  ${event.type}
                </span>
              </td>
              <td class="py-3 px-4 text-[#F3EFD8]">${event.label}</td>
              <td class="py-3 px-4 text-[#F3EFD8]/60 font-mono text-[10px]">${formattedTime}</td>
            </tr>
          `;
        }).join('');
      }
    }

    clearAnalyticsBtn?.addEventListener('click', () => {
      localStorage.removeItem('iks_archive_analytics_events');
      renderDashboard();
    });
  });
</script>